// Run NCCL's topology and device control flow on the host. The transport is a trace sink.
using ncclResult_t = int;
constexpr int ncclSuccess = 0, ncclInternalError = 1;
#define NCCLCHECK(call) do { int result = (call); if (result != ncclSuccess) return result; } while (0)
#define INFO(...) ((void)0)
#define WARN(...) ((void)0)
int log2i(unsigned n) { return 31 - __builtin_clz(n); }
struct ncclChannel { ncclTree tree; };
struct ncclComm {
  int nChannels, nNodes, node, nRanks, rank;
  ncclChannel channels[2];
};

/* SOURCE_TREE */

void expectTreePass(size_t& cursor, char operation, size_t begin, size_t length, size_t chunk) {
  for (size_t local = 0; local < length; local += chunk) {
    const Event& event = trace.at(cursor++);
    assert(event.op == operation);
    assert(event.offset == static_cast<ssize_t>(begin + local));
    assert(event.count == static_cast<int>(std::min(chunk, length - local)));
  }
}

void checkTreeExample() {
  constexpr size_t count = 4194303;
  const size_t budget = ncclCollTrafficPerChannel(count * sizeof(float) * 2, 2);
  const auto layout = ncclComputeCollChannelLayout(count, sizeof(float), 2, budget, 0, 0, 2);
  const int chunkSteps = ncclGetChunkSteps(Simple::Id, NCCL_ALGO_TREE, ALLREDUCE_CHUNKSTEPS);
  assert(chunkSteps == 1 && ncclGetSliceSteps(Simple::Id, NCCL_ALGO_TREE, ALLREDUCE_SLICESTEPS) == 1);
  const size_t chunkBytes = ncclGetChunkSize(Simple::Id, (4 << 20) / NCCL_STEPS, chunkSteps);
  const size_t chunk = chunkBytes / sizeof(float);
  assert(chunk == 131072 && layout.countLo == 2097152 && layout.countHi == 2097151);
  ncclDevWorkColl work{};
  work.channelHi = 1;
  work.cbd.countLo = layout.countLo;
  work.cbd.countHi = layout.countHi;
  work.cbd.chunkGrainsLo = work.cbd.chunkGrainsHi = chunkBytes / ncclProtoGrainSize(Simple::Id);
  int endpoints[] = {0, 1, 2, 3}; // One rank per node, endpoint rank equals node number.
  const int parents[2][4] = {{-1, 2, 0, 2}, {1, 3, 1, -1}};
  for (int rank = 0; rank < 4; ++rank) {
    ncclComm comm{1, 4, rank, 4, rank, {}};
    for (auto& channel : comm.channels) {
      channel.tree.up = -1;
      std::fill_n(channel.tree.down, NCCL_MAX_TREE_ARITY, -1);
    }
    assert(connectTrees(&comm, endpoints, endpoints, endpoints, nullptr) == ncclSuccess);
    for (int channel = 0; channel < 2; ++channel) {
      ncclShmem.channelId = channel;
      ncclShmem.channel.tree = comm.channels[channel].tree;
      const auto& tree = ncclShmem.channel.tree;
      assert(tree.up == parents[channel][rank]);
      for (int peer : endpoints) {
        const bool child = std::find(tree.down, tree.down + NCCL_MAX_TREE_ARITY, peer) != tree.down + NCCL_MAX_TREE_ARITY;
        assert(child == (parents[channel][peer] == rank));
      }
      const bool root = tree.up == -1;
      const bool leaf = tree.down[0] == -1;
      const char reduce = leaf ? 'S' : 'A', broadcast = leaf ? 'R' : 'C';
      const size_t begin = channel == 0 ? 0 : layout.countLo;
      const size_t length = channel == 0 ? layout.countLo : layout.countHi;
      // Representatives on either side of the 512-thread Simple split (320 up, 192 down).
      for (int tid : {319, 320}) {
        trace.clear();
        runTreeSplit<float, Sum, Simple>(tid, 512, &work);
        size_t cursor = 0;
        expectTreePass(cursor, root ? 'F' : (tid == 319 ? reduce : broadcast), begin, length, chunk);
        assert(trace.size() == cursor && cursor == 16);
        if (channel == 1) assert(trace.back().offset == 4063232 && trace.back().count == 131071);
      }
      trace.clear();
      runTreeUpDown<float, Sum, Simple>(0, 512, &work);
      size_t cursor = 0;
      expectTreePass(cursor, root ? 'U' : reduce, begin, length, chunk);
      expectTreePass(cursor, root ? 'B' : broadcast, begin, length, chunk);
      assert(trace.size() == cursor && cursor == 32);
    }
  }
  std::puts("PASS: Tree/Simple, four ranks, both channel trees, Split and UpDown, 16 chunks per channel.");
}
