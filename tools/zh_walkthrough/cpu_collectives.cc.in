// Record the user-buffer offsets of the four other Ring device bodies.
namespace ring_address_test {
using std::min;
inline size_t min(ssize_t chunk, size_t remaining) { assert(chunk >= 0); return std::min(size_t(chunk), remaining); }
struct Record { char op; ssize_t src, dst; int count; };
std::vector<Record> events;
template<class T, class Op, class Fan, int Direct, class Proto, int P, bool Offload=false>
struct Primitives {
  template<class... Args> Primitives(Args...) {}
  void send(ssize_t src,int n) { events.push_back({'S',src,-1,n}); }
  void recvReduceSend(ssize_t src,int n) { events.push_back({'A',src,-1,n}); }
  void recvReduceCopy(ssize_t src,ssize_t dst,int n,bool post) {
    assert(post); events.push_back({'F',src,dst,n});
  }
  void directSend(ssize_t src,ssize_t dst,int n) { events.push_back({'S',src,dst,n}); }
  void directCopySend(ssize_t src,ssize_t dst,int n) { events.push_back({'B',src,dst,n}); }
  void directRecvCopyDirectSend(ssize_t src,ssize_t dst,int n) { events.push_back({'C',src,dst,n}); }
  void directRecv(ssize_t dst,int n) { events.push_back({'R',-1,dst,n}); }
};
// Net offload and its extra copy threads are outside this fixture.
constexpr int COLL_UNROLL=1, NCCL_MAX_NET_SIZE=1<<20;
template<int, class Op, class T, int... Opts, class... Args>
void reduceCopy(Args...) { assert(false); }
inline void barrier_sync(int,int) { assert(false); }

/* SOURCE_COLLECTIVES */

void check(std::initializer_list<Record> expected) {
  assert(events.size()==expected.size());
  size_t i=0;
  for (auto r: expected) {
    const auto& e=events[i++];
    assert(e.op==r.op && e.src==r.src && e.dst==r.dst && e.count==r.count);
  }
  events.clear();
}

void run() {
  ncclDevWorkColl w{};
  float send[16]{}, recv[16]{};
  const int order[]={0,2,1,3};
  ncclShmem.comm.nRanks=4;
  ncclShmem.channelId=0;
  w.root=1; w.sendbuff=send; w.recvbuff=recv;
  w.cbd.chunkGrainsLo=1;
  for(int pos=0; pos<4; ++pos) {
    int rank=order[pos];
    ncclShmem.comm.rank=rank;
    auto& ring=ncclShmem.channel.ring;
    for (int j=0; j<4; ++j) ring.userRanks[j]=order[(pos+j)%4];
    int next=ring.userRanks[1], prev=ring.userRanks[3], opposite=ring.userRanks[2];
    for(bool inplace: {false,true}) {
      w.cbd.countLo=16; // AllGather and Broadcast are byte-normalized by the host.
      w.sendbuff=inplace ? recv+4*rank : send;
      ag::runRing<int8_t,Sum,Simple>(0,32,&w);
      check({{inplace?'S':'B',0,16*rank,16},{'C',16*prev,16*prev,16},
             {'C',16*opposite,16*opposite,16},{'R',-1,16*next,16}});
      w.sendbuff=inplace ? recv : send;
      bc::runRing<int8_t,Sum,Simple>(0,32,&w);
      if(rank==1) check({{inplace?'S':'B',0,0,16}});
      else if(next==1) check({{'R',-1,0,16}});
      else check({{'C',0,0,16}});
    }
    w.cbd.countLo=4; w.sendbuff=send;
    rs::runRing<float,Sum,Simple>(0,32,&w);
    check({{'S',4*prev,-1,4},{'A',4*opposite,-1,4},{'A',4*next,-1,4},{'F',4*rank,0,4}});
    rd::runRing<float,Sum,Simple>(0,32,&w);
    if(prev==1) check({{'S',0,-1,4}});
    else if(rank==1) check({{'F',0,0,4}});
    else check({{'A',0,-1,4}});
  }
  std::puts("PASS: nonsequential four-rank Ring, AG/RS address pairs, Broadcast/Reduce root roles, in-place and out-of-place byte copies.");
}
} // namespace ring_address_test
